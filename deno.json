{
  "tasks": {
    "dev": "deno run --allow-net --allow-env --env-file --watch main.ts",
    "test": "deno test --allow-env",
    "check": "deno check && deno lint && deno fmt --check",
    "set-webhook": "deno run --allow-net --allow-env --env-file scripts/set_webhook.ts",
    "bootstrap-sheet": "deno run --allow-net --allow-env --env-file scripts/bootstrap_sheet.ts"
  },
  "imports": {
    "grammy": "npm:grammy@^1.30.0",
    "@std/assert": "jsr:@std/assert@^1.0.0"
  },
  "fmt": { "lineWidth": 100 },
  "exclude": ["docs/", ".superpowers/"],
  "lock": true,
  "deploy": {
    "org": "brunoferraz-deno",
    "app": "denobot"
  }
}
