# Token do @BotFather (ex.: 123456789:AAExxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx).
BOT_TOKEN=

# String aleatória para validar o header X-Telegram-Bot-Api-Secret-Token em
# toda requisição ao webhook. Charset aceito pelo Telegram: A-Za-z0-9_- ,
# no máximo 256 caracteres (spec §10). Gere uma com:
#   openssl rand -hex 32
WEBHOOK_SECRET=

# URL pública onde o bot fica exposto (ex.: https://seu-app.deno.dev). Usada
# só por `deno task set-webhook`, que registra POST <PUBLIC_URL>/webhook
# no Telegram.
PUBLIC_URL=https://seu-app.deno.dev

# Conteúdo INTEIRO do JSON da service account, em UMA ÚNICA LINHA (copie e
# cole o arquivo baixado do Google Cloud sem quebras de linha). Dentro de
# "private_key" o \n precisa continuar como os dois caracteres escapados
# "\n", não uma quebra de linha real — lerServiceAccount (lib/google_auth.ts)
# desfaz esse escape na hora de montar a chave PEM; se a quebra já vier real,
# o JSON.parse quebra antes disso.
GOOGLE_SERVICE_ACCOUNT_JSON=

# O ID que aparece na URL da planilha, entre "/d/" e "/edit":
#   https://docs.google.com/spreadsheets/d/ESTE-TRECHO-AQUI/edit
SPREADSHEET_ID=

# IDs numéricos do Telegram autorizados a usar o bot, separados por vírgula
# (ex.: 111111111,222222222) — não é o @username. Para descobrir o seu,
# mande /start para @userinfobot (ou @RawDataBot) no Telegram e copie o "Id".
# Um formato inválido aqui (espaços em vez de vírgula, um "@usuario" colado,
# a lista vazia) faz o bot falhar já no boot, de propósito — ver
# exigirPermitidos em main.ts. Se o processo não subir, é o primeiro lugar
# para conferir.
ALLOWED_USER_IDS=
